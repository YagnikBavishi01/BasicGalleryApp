        <!--Gallery View Controller-->
        <scene sceneID="gallery-scene-001">
            <objects>
                <viewController storyboardIdentifier="GalleryViewController" id="gallery-vc-001" customClass="GalleryViewController" customModule="DemoBasicGalleryApp" customModuleProvider="target" sceneMemberID="viewController">
