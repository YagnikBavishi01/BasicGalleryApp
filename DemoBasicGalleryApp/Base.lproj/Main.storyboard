                                                <constraint firstItem="gallery-cellimage-001" firstAttribute="leading" secondItem="gallery-cellcontent-001" secondAttribute="leading" id="gallery-cc2"/>
                                                <constraint firstItem="gallery-cellimage-001" firstAttribute="trailing" secondItem="gallery-cellcontent-001" secondAttribute="trailing" id="gallery-cc3"/>
                                                <constraint firstItem="gallery-cellimage-001" firstAttribute="bottom" secondItem="gallery-cellcontent-001" secondAttribute="bottom" id="gallery-cc4"/>
                                                <constraint firstItem="gallery-cellauthor-001" firstAttribute="leading" secondItem="gallery-cellcontent-001" secondAttribute="leading" constant="8" id="gallery-cc5"/>
                                                <constraint firstItem="gallery-cellauthor-001" firstAttribute="trailing" secondItem="gallery-cellcontent-001" secondAttribute="trailing" constant="-8" id="gallery-cc6"/>
                                                <constraint firstItem="gallery-cellauthor-001" firstAttribute="bottom" secondItem="gallery-cellcontent-001" secondAttribute="bottom" constant="-6" id="gallery-cc7"/>
